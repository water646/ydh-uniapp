<template>
  <view class="live-push">
    <livepusherview
      ref="pusher"
      class="pusher"
      :url="publishUrl"
      @statechange="onState"
    ></livepusherview>

    <!-- 本地预览覆盖层：模拟推流烧入的比分条+水印，让直播者预览观众端画面。水印常驻，仅比分条随"隐藏比分"隐藏 -->
    <view class="preview-layer">
      <!-- 左上：联赛 logo + 联赛名 -->
      <view class="pv-top-left">
        <image v-if="leagueLogo" class="pv-league-logo" :src="leagueLogo" mode="aspectFill" />
        <text class="pv-league-name">{{ leagueName }}</text>
      </view>
      <!-- 右上：水印（只保留左半，右半裁掉） -->
      <view class="pv-watermark-clip">
        <image class="pv-watermark-img" src="/static/mipmap-xxhdpi/watermark.png" mode="aspectFit" />
      </view>
      <!-- 底部比分条（随"隐藏比分"隐藏，水印保留）：仿原生 new_bifen 背景 + 队名/比分/小节/犯规条 -->
      <view v-if="showScore" class="pv-scorebar-wrap">
        <view class="pv-scorebar">
          <image class="pv-bifen-bg" src="/static/mipmap-xxhdpi/new_bifen.png" mode="scaleToFill" />
          <image v-if="homeLogo" class="pv-team-logo pv-logo-home" :src="homeLogo" mode="aspectFill" />
          <view class="pv-cell pv-name-cell">
            <text class="pv-team-name">{{ homeName }}</text>
          </view>
          <view class="pv-cell pv-score-cell">
            <text class="pv-score">{{ hostScore }}</text>
            <image class="pv-foul" :src="foulHostImg" mode="scaleToFill" />
          </view>
          <view class="pv-cell pv-sec-cell">
            <text class="pv-section-text" v-if="section">{{ section }}</text>
          </view>
          <view class="pv-cell pv-score-cell">
            <text class="pv-score">{{ guestScore }}</text>
            <image class="pv-foul" :src="foulGuestImg" mode="scaleToFill" />
          </view>
          <view class="pv-cell pv-name-cell">
            <text class="pv-team-name">{{ guestName }}</text>
          </view>
          <image v-if="guestLogo" class="pv-team-logo pv-logo-guest" :src="guestLogo" mode="aspectFill" />
        </view>
        <view class="pv-sub-row">
          <text class="pv-sub-text">{{ leagueStageName }}</text>
        </view>
      </view>
      <!-- 小节结束报幕（顶部横幅：联赛名 + 主客队名/比分/第X节 + 下方球员统计表），10 秒后自动消失 -->
      <view v-if="sectionEnd" class="pv-section-end">
        <view class="pv-se-banner">
          <image class="pv-se-bg" src="/static/mipmap-xxhdpi/sectionbackground.png" mode="scaleToFill" />
          <view class="pv-se-content">
            <text class="pv-se-league">{{ leagueName }}</text>
            <view class="pv-se-row">
              <text class="pv-se-name pv-se-name-left">{{ homeName }}</text>
              <text class="pv-se-score pv-se-score-left">{{ hostScore }}</text>
              <text v-if="section" class="pv-se-section">{{ section }}</text>
              <text class="pv-se-score pv-se-score-right">{{ guestScore }}</text>
              <text class="pv-se-name pv-se-name-right">{{ guestName }}</text>
            </view>
          </view>
        </view>
        <!-- 球员统计表（主队左/客队右，最多 6 行） -->
        <view class="pv-se-stats">
          <image class="pv-se-stats-bg" src="/static/mipmap-xxhdpi/bottom.png" mode="scaleToFill" />
          <view class="pv-se-col">
            <view class="pv-se-tr pv-se-th">
              <text class="pv-se-td pv-se-td-name">球号/姓名</text>
              <text class="pv-se-td">得分</text>
              <text class="pv-se-td">助攻</text>
              <text class="pv-se-td">篮板</text>
            </view>
            <view v-for="(m, i) in hostMembers.slice(0, 6)" :key="'h' + i" class="pv-se-tr">
              <text class="pv-se-td pv-se-td-name">{{ m.number }} {{ m.name }}</text>
              <text class="pv-se-td">{{ m.score || 0 }}</text>
              <text class="pv-se-td">{{ m.assists || 0 }}</text>
              <text class="pv-se-td">{{ m.backboard || 0 }}</text>
            </view>
          </view>
          <view class="pv-se-col">
            <view class="pv-se-tr pv-se-th">
              <text class="pv-se-td pv-se-td-name">球号/姓名</text>
              <text class="pv-se-td">得分</text>
              <text class="pv-se-td">助攻</text>
              <text class="pv-se-td">篮板</text>
            </view>
            <view v-for="(m, i) in guestMembers.slice(0, 6)" :key="'g' + i" class="pv-se-tr">
              <text class="pv-se-td pv-se-td-name">{{ m.number }} {{ m.name }}</text>
              <text class="pv-se-td">{{ m.score || 0 }}</text>
              <text class="pv-se-td">{{ m.assists || 0 }}</text>
              <text class="pv-se-td">{{ m.backboard || 0 }}</text>
            </view>
          </view>
        </view>
      </view>
      <!-- 底部消息条 -->
      <view v-if="msg && msg !== '小节结束'" class="pv-msg">
        <text class="pv-msg-text">{{ msg }}</text>
      </view>
    </view>

    <!-- 控制覆盖层（横屏铺满，view 可覆盖原生推流组件） -->
    <view class="overlay">
      <view class="top">
        <text class="gray-btn" style="height: 40rpx;" @click="back">返回</text>
        <text class="status">{{ statusText }}</text>
        <text class="gray-btn" @click="toggleScore">{{ showScore ? '隐藏' : '显示' }}比分</text>
        <text class="gray-btn" @click="reconnectScore">比分重连</text>
      </view>

      <view class="bottom">
        <view class="bottom-row">
          <text class="gray-btn" @click="startPush">{{ pushing ? '直播中' : '开始直播' }}</text>
          <text class="gray-btn" @click="stopPush">结束直播</text>
        </view>
        <text class="gray-btn" @click="onCompose">生成回放</text>
      </view>
    </view>
  </view>
</template>

<script setup>
/**
 * 统一推流页（横屏，腾讯 LiteAV 原生插件 TencentLivePusher 烧流版）
 * - <livepusherview> 原生组件封装 TXLivePusher，setWatermark 把比分条 Bitmap 烧进推流画面
 * - WebSocket group=push 接收实时比分 -> updateScore() 烧流
 * - 荣耀机 logcat 加密，诊断日志写 /sdcard/push_debug.log 供 adb pull 读取
 * - 原生插件不支持标准基座，须自定义调试基座或正式云打包勾选 TencentLivePusher
 */
import { ref, computed } from 'vue'
import { onLoad, onReady, onUnload, onBackPress } from '@dcloudio/uni-app'
import { connectSocket, closeSocket } from '@/utils/websocket'
import { getGameDetail } from '@/api/game'
import { compose, getLiveGameList } from '@/api/live'

const publishUrl = ref('')
const gameId = ref('')
const homeName = ref('主队')
const guestName = ref('客队')
const homeLogo = ref('')
const guestLogo = ref('')
const hostScore = ref(0)
const guestScore = ref(0)
const section = ref('')
const hostFoul = ref(0)
const guestFoul = ref(0)
const leagueName = ref('')
const leagueLogo = ref('')
const leagueStageName = ref('')
const msg = ref('')
const hostMembers = ref([])
const guestMembers = ref([])

/** 底部消息条定时器：显示 5 秒后自动消失 */
let msgTimer = null
function setMsg(text) {
  msg.value = text
  if (msgTimer) clearTimeout(msgTimer)
  if (text) {
    msgTimer = setTimeout(() => {
      msg.value = ''
      // 重新烧一次流，把烧进画面的 msg 条也一并清掉（原生是 1.8s 后 addWaterMark(null) 清）
      // 报幕展示期间不刷，避免提前顶掉报幕画面
      if (!sectionEnd.value) pushScore()
    }, 5000)
  }
}

/** 犯规指示条图片：原生用 fangui0~5（犯规次数 0-5，超过 5 封顶） */
function foulImg(n) {
  const c = Math.max(0, Math.min(5, Number(n) || 0))
  return `/static/mipmap-xxhdpi/fangui${c}.png`
}
const foulHostImg = computed(() => foulImg(hostFoul.value))
const foulGuestImg = computed(() => foulImg(guestFoul.value))

const showScore = ref(true)
/** 小节结束「报幕」：显示整屏小节比分画面，10 秒后自动切回比分条 */
const sectionEnd = ref(false)
let sectionEndTimer = null
/** WS 是否已成功连过一次：重连成功时补拉一次全量比分，找回断线期间错过的分数（#2） */
let wsEverOpened = false
/** 断网自动重推状态（#1）：wantPush=用户意图推流，手动「结束直播」置 false 防误重连 */
let wantPush = false
let pushRetryTimer = null
let pushRetryCount = 0
const MAX_PUSH_RETRY = 5
/** 推流连接中(等待 1005 成功事件)：「开始直播」防重复点击锁，15s 兜底解锁 */
let pushConnecting = false
let pushConnectingTimer = null
const pushing = ref(false)
const statusText = ref('未连接')
const pusher = ref(null)

/** 诊断日志写到 app 私有目录 push_debug.log（荣耀机 logcat 加密，改用文件供 adb pull） */
function logToFile(msg) {
  // #ifdef APP-PLUS
  try {
    const ts = new Date().toLocaleString()
    const main = plus.android.runtimeMainActivity()
    const File = plus.android.importClass('java.io.File')
    const FileWriter = plus.android.importClass('java.io.FileWriter')
    const dir = main.getExternalFilesDir(null)  // /sdcard/Android/data/<包名>/files，免存储权限
    const f = new File(dir, 'push_debug.log')
    const fw = new FileWriter(f, true)
    fw.write(ts + ' ' + msg + '\n')
    fw.close()
  } catch (e) {
    console.log('logToFile err: ' + e)
  }
  // #endif
}

onLoad((opt) => {
  // 锁定横屏：腾讯推流 540×960 横向采集 + 比分条 960×545 横向，方向才正确
  // #ifdef APP-PLUS
  plus.screen.lockOrientation('landscape-primary')
  // #endif
  publishUrl.value = decodeURIComponent(opt.livepublish || '')
  gameId.value = opt.gameId || ''
  homeName.value = opt.name || '直播'
  console.log('[push] publishUrl=', publishUrl.value, 'gameId=', gameId.value)
  logToFile('[push] onLoad url=' + publishUrl.value + ' gameId=' + gameId.value + ' name=' + opt.name)
  loadGameDetail()
  connectScore()
})

/** 申请相机/麦克风权限（Android 运行时权限） */
function ensurePermissions() {
  // #ifdef APP-PLUS
  return new Promise((resolve) => {
    try {
      plus.android.requestPermissions(
        ['android.permission.CAMERA', 'android.permission.RECORD_AUDIO'],
        () => resolve(true),
        () => resolve(false)
      )
    } catch (e) {
      resolve(true)
    }
  })
  // #endif
  // #ifndef APP-PLUS
  return Promise.resolve(true)
  // #endif
}

onReady(() => {
  ensurePermissions().then((granted) => {
    console.log('[push] permissions granted=', granted, 'pusher=', pusher.value)
    logToFile('[push] onReady permissions=' + granted + ' pusher=' + (pusher.value ? 'yes' : 'null'))
    if (!granted) {
      uni.showToast({ title: '需要相机/麦克风权限', icon: 'none' })
      logToFile('[push] 权限未授予，无法预览')
      return
    }
    // 原生组件 ref 绑定可能晚于 onReady，轮询确保拿到再开预览
    let tries = 0
    const tryPreview = () => {
      if (pusher.value) {
        console.log('[push] startPreview 调用')
        logToFile('[push] startPreview 调用，组件已挂载')
        pusher.value.startPreview()
        logToFile('[push] startPreview 调用完成')
        // 预览启动后立即烧一次比分条(用当前已有数据,不等 WebSocket/loadGameDetail)
        pushScore()
        logToFile('[push] startPreview 后立即 pushScore 一次')
      } else if (tries++ < 20) {
        setTimeout(tryPreview, 100)
      } else {
        console.log('[push] pusher ref 始终为 null -- livepusherview 组件未注册/未挂载')
        logToFile('[push] ✗ pusher ref 始终为 null -- livepusherview 组件未注册/未挂载（插件未打进基座）')
        uni.showToast({ title: '推流组件未加载，请确认插件已打包', icon: 'none' })
      }
    }
    setTimeout(tryPreview, 300)
  })
})

onUnload(() => {
  stopPush()
  if (pusher.value) {
    try { pusher.value.stopPreview() } catch (e) {}
  }
  closeSocket()
  // #ifdef APP-PLUS
  // 主动锁回竖屏（unlockOrientation 仅解除锁定，不会自动转回竖屏，导致退出后仍横屏）
  plus.screen.lockOrientation('portrait-primary')
  // #endif
})

function loadGameDetail() {
  // 拉比赛详情取队名/比分/联赛（篮球 game/{id}/detail；足球 soccer/）
  getGameDetail(gameId.value, 'basketball').then((res) => {
    if (res.code !== 1) {
      logToFile('[push] loadGameDetail code=' + res.code)
      return
    }
    const page = res.data || {}
    const g = page.game || page
    if (g.hostTeamName) homeName.value = g.hostTeamName
    if (g.guestTeamName) guestName.value = g.guestTeamName
    if (g.hostTeamLogo) homeLogo.value = g.hostTeamLogo
    if (g.guestTeamLogo) guestLogo.value = g.guestTeamLogo
    hostScore.value = g.hostTeamScore || 0
    guestScore.value = g.guestTeamScore || 0
    if (g.leagueName) leagueName.value = g.leagueName
    if (g.leagueLogo) leagueLogo.value = g.leagueLogo
    if (g.leagueStageName) leagueStageName.value = g.leagueStageName
    if (g.hostTeamFoul !== undefined) hostFoul.value = g.hostTeamFoul
    if (g.guestTeamFoul !== undefined) guestFoul.value = g.guestTeamFoul
    // 报幕球员统计表数据源：game/{id}/detail 的 data.hostMembers/guestMembers(每个含 number/name/score/assists/backboard)
    hostMembers.value = page.hostMembers || []
    guestMembers.value = page.guestMembers || []
    logToFile('[push] loadGameDetail OK host=' + homeName.value + ' guest=' + guestName.value + ' score=' + hostScore.value + ':' + guestScore.value + ' members=' + hostMembers.value.length + '/' + guestMembers.value.length)
    // 报幕展示期间不刷：详情刷新触发的 pushScore 会提前顶掉报幕画面
    if (!sectionEnd.value) pushScore()
  })
}

/** 连接 WebSocket 接收实时比分（对应原生 group=push<gameId>，不是写死的 push） */
function connectScore() {
  statusText.value = '比分接口连接中…'
  connectSocket(
    'push' + gameId.value,
    (data) => {
      logToFile('[push] ws msg ' + JSON.stringify(data))
      // 用 != null 同时挡掉 null 和 undefined：后端「违体/犯规」类消息会把比分/犯规字段置 null，
      // 若用 !== undefined 会让 null 覆盖掉已有比分，导致比分条被清空
      if (data.hostTeamScore != null) hostScore.value = data.hostTeamScore
      if (data.guestTeamScore != null) guestScore.value = data.guestTeamScore
      if (data.section != null) section.value = data.section
      if (data.hostTeamFoul != null) hostFoul.value = data.hostTeamFoul
      if (data.guestTeamFoul != null) guestFoul.value = data.guestTeamFoul
      // 「小节结束」不作底部消息条，改触发整屏报幕
      if (data.msg != null && data.msg !== '小节结束') setMsg(data.msg)
      if (data.leagueStageName != null) leagueStageName.value = data.leagueStageName
      // 小节结束 -> 报幕；否则正常刷新比分条
      if (data.runStatus === 'SECTION_END' || data.msg === '小节结束') {
        showSectionEnd()
      } else if (!sectionEnd.value) {
        // 报幕展示的 10 秒内不刷比分条：心跳(每20s)或普通消息触发的 pushScore 会提前顶掉报幕画面
        pushScore()
      }
    },
    (event) => {
      if (event === 'open') {
        statusText.value = '比分接口已连接'
        logToFile('[push] ws open group=push' + gameId.value)
        // #2 断线重连成功(非首次连接)：补拉一次全量比分，找回断线期间错过的分数
        if (wsEverOpened) {
          logToFile('[push] ws 重连成功，补拉比分')
          loadGameDetail()
        }
        wsEverOpened = true
      }
      else if (event === 'close') statusText.value = '比分接口已断开，重连中…'
      else if (event === 'error') statusText.value = '比分接口连接失败'
    }
  )
}

function reconnectScore() {
  closeSocket()
  connectScore()
}

/** 把当前比分烧进推流画面（ScoreBitmapDrawer 画 960×545 Bitmap -> setWatermark） */
function pushScore() {
  if (!pusher.value) {
    logToFile('[push] pushScore skip: pusher=null')
    return
  }
  // showScore=false 时仍调用,传 showScorebar=false 让原生只画水印(隐藏比分条,保留水印烧流)
  logToFile('[push] updateScore host=' + hostScore.value + ' guest=' + guestScore.value + ' showScorebar=' + showScore.value)
  pusher.value.updateScore({
    hostName: homeName.value,
    guestName: guestName.value,
    hostScore: String(hostScore.value),
    guestScore: String(guestScore.value),
    section: section.value,
    hostFoul: hostFoul.value,
    guestFoul: guestFoul.value,
    hostLogo: homeLogo.value,
    guestLogo: guestLogo.value,
    leagueName: leagueName.value,
    leagueLogo: leagueLogo.value,
    leagueStageName: leagueStageName.value,
    msg: msg.value,
    showScorebar: showScore.value
  })
}

function startPush() {
  if (!publishUrl.value) {
    uni.showToast({ title: '推流地址为空，无法直播', icon: 'none' })
    return
  }
  if (!pusher.value) {
    uni.showToast({ title: '推流组件未就绪', icon: 'none' })
    logToFile('[push] startPush 失败：pusher ref null')
    return
  }
  // 防重复点击：已在直播 / 正在连接中 都不允许再触发 startPusher
  if (pushing.value) {
    uni.showToast({ title: '已在直播中', icon: 'none' })
    return
  }
  if (pushConnecting) {
    uni.showToast({ title: '正在连接，请稍候', icon: 'none' })
    return
  }
  logToFile('[push] startPush url=' + publishUrl.value)
  // 手动重开时取消还在排队的自动重推，避免内部重试到点后再顶一次
  if (pushRetryTimer) { clearTimeout(pushRetryTimer); pushRetryTimer = null }
  wantPush = true
  pushConnecting = true
  // 兜底：15s 内没等到 1005(SDK 立即失败可能不发事件)自动解锁，允许再点
  if (pushConnectingTimer) clearTimeout(pushConnectingTimer)
  pushConnectingTimer = setTimeout(() => { pushConnecting = false; pushConnectingTimer = null }, 15000)
  pusher.value.startPush(publishUrl.value)
  statusText.value = '推流连接中…'
}

function stopPush() {
  // 手动结束：清掉自动重推状态，防止 -1305 到达后又把流拉起来
  wantPush = false
  if (pushRetryTimer) { clearTimeout(pushRetryTimer); pushRetryTimer = null }
  pushRetryCount = 0
  pushConnecting = false
  if (pushConnectingTimer) { clearTimeout(pushConnectingTimer); pushConnectingTimer = null }
  if (pusher.value) {
    pusher.value.stopPush()
    pushing.value = false
    statusText.value = '已结束'
    logToFile('[push] stopPush')
  }
}

/**
 * #1 断网自动重推：3s 起步线性退避(3/6/9/12/15s)，最多 5 次，重连成功(1005)后重置计数；
 * 手动「结束直播」不自动重连(wantPush=false)
 */
function schedulePushRetry() {
  if (pushRetryTimer) return   // 已有重试在排队，-1305 重复到达时不再叠加
  if (pushRetryCount >= MAX_PUSH_RETRY) {
    statusText.value = '直播中断，请点「开始直播」重连'
    uni.showToast({ title: '自动重连失败，请手动重连', icon: 'none' })
    logToFile('[push] 自动重推达上限(' + MAX_PUSH_RETRY + '次)，等待手动重连')
    return
  }
  const delay = Math.min(3000 * (pushRetryCount + 1), 15000)
  pushRetryCount++
  statusText.value = '网络中断，' + Math.round(delay / 1000) + '秒后自动重连…'
  logToFile('[push] 断网，' + delay + 'ms 后自动重推(第' + pushRetryCount + '次)')
  pushRetryTimer = setTimeout(() => {
    pushRetryTimer = null
    // 重推前先刷新推流地址(auth_key 有时效)，失败则沿用旧地址
    refreshPublishUrl().then(() => {
      if (wantPush) startPush()
    })
  }, delay)
}

/** 清除「开始直播」防重复点击锁(1005 成功 / -1305 失败 / 手动结束时调用) */
function clearConnectingLock() {
  pushConnecting = false
  if (pushConnectingTimer) { clearTimeout(pushConnectingTimer); pushConnectingTimer = null }
}

/** 刷新推流地址：game-list 里找同一路流(streamName 相同)的新 publish */
function refreshPublishUrl() {
  return getLiveGameList(gameId.value).then((res) => {
    if (res.code !== 1 || !res.data || !res.data.length) return
    const m = publishUrl.value.match(/game\/([^?]+)/)
    if (!m) return
    const hit = res.data.find((it) => (it.publish || '').indexOf('game/' + m[1]) !== -1)
    if (hit && hit.publish && hit.publish !== publishUrl.value) {
      publishUrl.value = hit.publish
      logToFile('[push] 重推前已刷新推流地址')
    }
  }).catch(() => {})
}

function switchCamera() {
  if (pusher.value) pusher.value.switchCamera()
}

function toggleScore() {
  showScore.value = !showScore.value
  // 隐藏比分时只隐藏比分条,水印保留(showScorebar=false 让原生只画水印)
  pushScore()
}

/** 小节结束报幕：烧整屏小节比分画面 + 球员统计表，10 秒后自动恢复比分条（原生 2s 太短看不清，加长） */
function showSectionEnd() {
  sectionEnd.value = true
  if (sectionEndTimer) clearTimeout(sectionEndTimer)
  burnSectionEnd()
  // 原生在小节结束时会重新拉 game/{id}/detail 刷新球员统计，这里同步刷新一次，若窗口内返回则重烧更准的统计
  getGameDetail(gameId.value, 'basketball').then((res) => {
    if (res.code !== 1 || !sectionEnd.value) return
    const page = res.data || {}
    hostMembers.value = page.hostMembers || []
    guestMembers.value = page.guestMembers || []
    logToFile('[push] 报幕刷新球员统计 members=' + hostMembers.value.length + '/' + guestMembers.value.length)
    burnSectionEnd()
  })
  sectionEndTimer = setTimeout(() => {
    sectionEnd.value = false
    pushScore()   // 恢复比分条
  }, 10000)
}

/** 把当前报幕(小节比分 + 球员统计)烧进推流画面 */
function burnSectionEnd() {
  if (!pusher.value) return
  logToFile('[push] 小节结束 报幕 section=' + section.value + ' ' + hostScore.value + ':' + guestScore.value + ' members=' + hostMembers.value.length + '/' + guestMembers.value.length)
  pusher.value.showSectionEnd({
    leagueName: leagueName.value,
    hostName: homeName.value,
    guestName: guestName.value,
    hostScore: String(hostScore.value),
    guestScore: String(guestScore.value),
    section: section.value,
    hostLogo: homeLogo.value,
    guestLogo: guestLogo.value,
    hostMembers: hostMembers.value,
    guestMembers: guestMembers.value
  })
}

function onState(e) {
  const d = e.detail || {}
  console.log('[pusher] state', d)
  logToFile('[pusher] state code=' + d.code + ' msg=' + d.msg)
  if (d.msg) statusText.value = d.msg
  if (d.code === 1005) {
    pushing.value = true           // PUSH_EVT_CONNECT_SUCC
    pushRetryCount = 0             // 推流恢复，重置自动重推计数
    clearConnectingLock()
  } else if (d.code === -1305) {   // PUSH_ERR_NET_DISCONNECT
    pushing.value = false
    clearConnectingLock()
    if (wantPush) schedulePushRetry()   // #1 非手动结束 -> 自动重推
  }
}

/** 生成回放（POST live/stream/compose） */
function onCompose() {
  compose({ gameId: gameId.value }).then((res) => {
    uni.showToast({ title: res.code === 1 ? '已生成回放' : '生成失败', icon: 'none' })
  })
}

function back() {
  if (msgTimer) clearTimeout(msgTimer)
  if (sectionEndTimer) clearTimeout(sectionEndTimer)
  try { stopPush() } catch (e) {}
  if (pusher.value) { try { pusher.value.stopPreview() } catch (e) {} }
  try { closeSocket() } catch (e) {}
  // #ifdef APP-PLUS
  plus.screen.lockOrientation('portrait-primary')
  // #endif
  uni.navigateBack()
}

// 系统手势/物理返回兜底：onUnload 在 nvue 不触发，用 onBackPress 保证锁回竖屏
onBackPress(() => {
  if (msgTimer) clearTimeout(msgTimer)
  if (sectionEndTimer) clearTimeout(sectionEndTimer)
  try { stopPush() } catch (e) {}
  if (pusher.value) { try { pusher.value.stopPreview() } catch (e) {} }
  try { closeSocket() } catch (e) {}
  // #ifdef APP-PLUS
  plus.screen.lockOrientation('portrait-primary')
  // #endif
  return false
})
</script>

