<template>
  <view class="live-push">
    <live-pusher
      id="pusher"
      class="pusher"
      :url="publishUrl"
      mode="FHD"
      :enable-camera="true"
      :auto-focus="true"
      :beauty="0"
      :muted="false"
      device-position="back"
      @statechange="onState"
      @error="onError"
    ></live-pusher>

    <!-- 控制覆盖层（nvue 中 view 可覆盖 live-pusher） -->
    <!-- 容器宽高与屏幕互换 + 顺时针旋转90°，旋转后正好铺满竖屏，内容不超出 -->
    <view class="overlay" :style="overlayStyle">
      <view class="top">
        <view class="back" @click="back"><text class="back-icon">‹</text></view>
        <text class="status">{{ statusText }}</text>
        <text class="reconnect" @click="reconnectScore">比分重连</text>
      </view>

      <!-- 实时比分浮层（降级方案：本地显示，不烧进推流画面） -->
      <view v-if="showScore" class="score-overlay">
        <text class="s-team">{{ homeName }}</text>
        <text class="s-score">{{ hostScore }}</text>
        <text class="s-colon">:</text>
        <text class="s-score">{{ guestScore }}</text>
        <text class="s-team">{{ guestName }}</text>
      </view>
      <text v-if="section" class="s-section">{{ section }}</text>

      <view class="bottom">
        <text v-if="!pushing" class="btn start" @click="startPush">开始直播</text>
        <text v-else class="btn stop" @click="stopPush">结束直播</text>
        <text class="btn" @click="switchCamera">翻转</text>
        <text class="btn" @click="toggleScore">{{ showScore ? '隐藏' : '显示' }}比分</text>
        <text class="btn" @click="onCompose">生成回放</text>
      </view>
    </view>
  </view>
</template>

<script setup>
/**
 * 统一推流页（合并原 TencentCloudActivity / NeWTencentLiveActivity / StreamingFootActivity）
 * - 用 <live-pusher> 替代腾讯 LiteAV / 网易 / 金山云三套推流 SDK
 * - WebSocket group=push 接收实时比分，更新本地比分浮层
 *   （原项目用 Canvas 合成比分 Bitmap 烧进推流画面 setWatermark，
 *    uniapp live-pusher 仅支持静态水印无法烧动态 Canvas，降级为本地浮层；
 *    保真需封装 uni 原生插件包装 TXLivePusher.setWatermark）
 * - 生成回放 POST live/stream/compose
 * - nvue 渲染：App 端 live-pusher 需 nvue 才能正常显示预览并允许 view 覆盖
 */
import { ref, onUnmounted, getCurrentInstance } from 'vue'
import { onLoad, onReady } from '@dcloudio/uni-app'
import { connectSocket, closeSocket } from '@/utils/websocket'
import { getGameDetail } from '@/api/game'
import { compose } from '@/api/live'

const publishUrl = ref('')
const gameId = ref('')
const homeName = ref('主队')
const guestName = ref('客队')
const hostScore = ref(0)
const guestScore = ref(0)
const section = ref('')
const showScore = ref(true)
const pushing = ref(false)
const statusText = ref('未连接')
let pusherCtx = null
const instance = getCurrentInstance()

/**
 * 横屏浮层：将容器宽高与屏幕互换（宽=屏高 h、高=屏宽 750）并居中，
 * 顺时针旋转 90° 后视觉正好铺满竖屏（视觉宽=750、高=h）。
 * 直接旋转全屏浮层会让视觉宽变成 h（>750）从而超出屏幕，互换尺寸即可避免。
 */
const overlayStyle = (() => {
  let h = 1334 // 屏高(rpx)兜底值
  try {
    const info = uni.getSystemInfoSync()
    if (info.windowWidth && info.windowHeight) {
      h = Math.round((750 * info.windowHeight) / info.windowWidth)
    }
  } catch (e) {}
  return {
    width: h + 'rpx',
    height: '750rpx',
    left: (750 - h) / 2 + 'rpx',
    top: (h - 750) / 2 + 'rpx'
  }
})()

/** 创建推流上下文（nvue 需传入当前组件实例，否则回调里报 $page undefined） */
function getPusherCtx() {
  if (!pusherCtx) {
    pusherCtx = uni.createLivePusherContext('pusher', instance && instance.proxy)
  }
  return pusherCtx
}

onLoad((opt) => {
  // 锁定竖屏：画面竖屏、按钮横排，均不随手机翻转
  // #ifdef APP-PLUS
  plus.screen.lockOrientation('portrait-primary')
  // #endif
  publishUrl.value = decodeURIComponent(opt.livepublish || '')
  gameId.value = opt.gameId || ''
  homeName.value = opt.name || '直播'
  console.log('[push] publishUrl=', publishUrl.value, 'gameId=', gameId.value)
  loadGameDetail()
  connectScore()
})

/** 申请相机/麦克风权限（Android 运行时权限） */
function ensurePermissions() {
  // #ifdef APP-PLUS
  return new Promise((resolve) => {
    try {
      plus.android.requestPermissions(
        ['android.permission.CAMERA', 'android.permission.RECORD_AUDIO'],
        () => resolve(true),
        () => resolve(false)
      )
    } catch (e) {
      resolve(true)
    }
  })
  // #endif
  // #ifndef APP-PLUS
  return Promise.resolve(true)
  // #endif
}

/** 开启本地摄像头预览（不推流） */
function startPreview() {
  const ctx = getPusherCtx()
  if (!ctx) {
    console.log('[pusher] createLivePusherContext 失败，组件未挂载')
    return
  }
  ctx.startPreview({
    success: () => console.log('[pusher] 预览已开启'),
    fail: (err) => {
      console.log('[pusher] 预览开启失败', err)
      uni.showToast({ title: '摄像头开启失败，请检查权限', icon: 'none' })
    }
  })
}

// 组件挂载完成后申请权限并开启预览
onReady(() => {
  ensurePermissions().then(() => {
    setTimeout(startPreview, 200)
  })
})

onUnmounted(() => {
  stopPush()
  if (pusherCtx) {
    try { pusherCtx.stopPreview() } catch (e) {}
  }
  closeSocket()
  // #ifdef APP-PLUS
  plus.screen.unlockOrientation()
  // #endif
})

function loadGameDetail() {
  // 拉比赛详情取队名/比分（篮球 game/{id}/detail；足球 soccer/）
  getGameDetail(gameId.value, 'basketball').then((res) => {
    if (res.code !== 1) return
    const page = res.data || {}
    const g = page.game || page
    if (g.hostTeamName) homeName.value = g.hostTeamName
    if (g.guestTeamName) guestName.value = g.guestTeamName
    hostScore.value = g.hostTeamScore || 0
    guestScore.value = g.guestTeamScore || 0
  })
}

/** 连接 WebSocket 接收实时比分（对应 group=push） */
function connectScore() {
  statusText.value = '比分接口连接中…'
  connectSocket(
    'push',
    (data) => {
      // 收到实时比分数据
      if (data.hostTeamScore !== undefined) hostScore.value = data.hostTeamScore
      if (data.guestTeamScore !== undefined) guestScore.value = data.guestTeamScore
      if (data.section !== undefined) section.value = data.section
    },
    (event) => {
      // 连接状态：以 onOpen 为准，不再依赖收到消息
      if (event === 'open') statusText.value = '比分接口已连接'
      else if (event === 'close') statusText.value = '比分接口已断开，重连中…'
      else if (event === 'error') statusText.value = '比分接口连接失败'
    }
  )
}

function reconnectScore() {
  closeSocket()
  connectScore()
}

function startPush() {
  if (!publishUrl.value) {
    uni.showToast({ title: '推流地址为空，无法直播', icon: 'none' })
    return
  }
  const ctx = getPusherCtx()
  if (!ctx) {
    uni.showToast({ title: '推流组件未就绪', icon: 'none' })
    return
  }
  ctx.start({
    success: () => {
      pushing.value = true
      statusText.value = '直播中'
    },
    fail: () => {
      uni.showToast({ title: '推流失败', icon: 'none' })
    }
  })
}

function stopPush() {
  if (pusherCtx) {
    pusherCtx.stop()
    pushing.value = false
    statusText.value = '已结束'
  }
}

function switchCamera() {
  if (pusherCtx) pusherCtx.switchCamera()
}

function toggleScore() {
  showScore.value = !showScore.value
}

function onState(e) {
  console.log('[pusher] state', e.detail)
}

function onError(e) {
  console.log('[pusher] error', e.detail)
  uni.showToast({ title: '推流错误', icon: 'none' })
}

/** 生成回放（POST live/stream/compose） */
function onCompose() {
  compose({ gameId: gameId.value }).then((res) => {
    uni.showToast({ title: res.code === 1 ? '已生成回放' : '生成失败', icon: 'none' })
  })
}

function back() {
  uni.navigateBack()
}
</script>

<style lang="scss" scoped>
.live-push {
  flex: 1;
  background-color: #000000;
}
.pusher {
  flex: 1;
}
.overlay {
  position: absolute;
  /* 宽高/位置由 overlayStyle 注入（与屏幕互换并居中），
     以中心为原点顺时针旋转90°后铺满竖屏 */
  transform: rotate(90deg);
  transform-origin: 50% 50%;
}
.top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  flex-direction: row;
  align-items: center;
  padding: 10rpx;
  height: 40rpx;
}
.back {
  width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  background-color: rgba(0, 0, 0, 0.4);
  align-items: center;
  justify-content: center;
}
.back-icon {
  font-size: 22rpx;
  color: #ffffff;
}
.status {
  flex: 1;
  text-align: center;
  color: #ffffff;
  font-size: 12rpx;
}
.reconnect {
  font-size: 12rpx;
  color: #009de9;
}
.score-overlay {
  position: absolute;
  top: 50rpx;
  left: 10rpx;
  flex-direction: row;
  align-items: center;
  background-color: rgba(0, 0, 0, 0.5);
  padding: 6rpx 10rpx;
  border-radius: 4rpx;
}
.s-team {
  font-size: 13rpx;
  color: #ffffff;
  margin: 0 5rpx;
}
.s-score {
  font-size: 20rpx;
  color: #ff6f21;
  font-weight: bold;
  margin: 0 5rpx;
}
.s-colon {
  font-size: 16rpx;
  color: #ffffff;
}
.s-section {
  position: absolute;
  top: 50rpx;
  right: 10rpx;
  font-size: 12rpx;
  color: #ffffff;
  background-color: rgba(0, 0, 0, 0.5);
  padding: 4rpx 8rpx;
  border-radius: 4rpx;
}
.bottom {
  position: absolute;
  bottom: 20rpx;
  left: 0;
  right: 0;
  flex-direction: row;
  justify-content: center;
  flex-wrap: wrap;
}
.btn {
  font-size: 13rpx;
  color: #ffffff;
  padding: 8rpx 14rpx;
  margin: 5rpx;
  border-radius: 15rpx;
  background-color: rgba(0, 0, 0, 0.5);
}
.btn.start {
  background-color: #29a871;
}
.btn.stop {
  background-color: #ff2d2d;
}
</style>
